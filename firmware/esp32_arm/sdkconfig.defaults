# Project-specific overrides of ESP-IDF defaults.
# sdkconfig is generated from this file when it doesn't exist (it is not versioned).

CONFIG_IDF_TARGET="esp32"

# Console on UART1 so UART0 (USB) is used only by the PC protocol.
# RX must be set explicitly: its default (GPIO3) is UART0 RX.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_1=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=14
CONFIG_ESP_CONSOLE_UART_RX_GPIO=27
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Both boards have 4MB flash (esptool flash_id); the ESP-IDF default is 2MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
